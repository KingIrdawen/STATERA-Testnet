# Configuration npm pour React 19
# Les warnings de peer dependencies sont normaux et ne bloquent pas le build
# Ils sont causés par des dépendances transitives (valtio via wagmi/rainbowkit) 
# qui n'ont pas encore été mises à jour pour React 19
# Le build fonctionne correctement malgré ces warnings

# Ne pas utiliser legacy-peer-deps car cela peut causer d'autres problèmes
# Les warnings sont acceptables et n'empêchent pas le fonctionnement

# Vercel deployment configuration
engine-strict=true
prefer-frozen-lockfile=false

# Force registry and safer fetch settings for pnpm
registry=https://registry.npmjs.org/

# Make network behavior more tolerant on CI
fetch-retries=10
fetch-retry-factor=2
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000

# Reduce flaky socket behavior in some CI environments ensuring no keepalive reuse issues
http-timeout=120000
strict-ssl=true

# Important for pnpm in some environments: avoid prefer-offline
prefer-offline=false

